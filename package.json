{
  "name": "korea-transit-mcp",
  "version": "0.3.1",
  "description": "MCP server for Korean public bus data (stops, real-time arrivals, routes, bus locations) via data.go.kr TAGO APIs",
  "mcpName": "io.github.98Woonho/korea-transit-mcp",
  "type": "module",
  "bin": {
    "korea-transit-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "version": "node scripts/sync-version.mjs && git add server.json plugin/.claude-plugin/plugin.json"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "korea",
    "transit",
    "bus",
    "public-data",
    "data.go.kr",
    "tago"
  ],
  "author": "98Woonho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/98Woonho/korea-transit-mcp.git"
  },
  "homepage": "https://github.com/98Woonho/korea-transit-mcp#readme",
  "bugs": {
    "url": "https://github.com/98Woonho/korea-transit-mcp/issues"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
